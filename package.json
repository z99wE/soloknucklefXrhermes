{
  "name": "soloknuckle",
  "version": "5.2.0",
  "description": "Production hygiene for solo developers: secret scanning, a command firewall, and a health score. Local-first, no telemetry.",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "soloknuckle": "dist/cli/index.js",
    "soloknuckle-mcp": "dist/cli/mcp-server.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "build:bin": "node scripts/build-binaries.mjs",
    "dev": "tsx cli/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:plugin": "python3 -m pytest hermes-plugin/tests -q",
    "test:smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/z99wE/soloknucklefXrhermes.git"
  },
  "keywords": [
    "security",
    "secrets",
    "secret-scanning",
    "cli",
    "pre-commit",
    "mcp",
    "hermes",
    "hermes-agent",
    "developer-tools",
    "hygiene",
    "guardrails"
  ],
  "author": "Soloknuckle Contributors",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/z99wE/soloknucklefXrhermes/issues"
  },
  "homepage": "https://github.com/z99wE/soloknucklefXrhermes#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "5.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
