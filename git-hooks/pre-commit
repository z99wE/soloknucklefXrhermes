#!/usr/bin/env bash
# pre-commit - the quality gate for this repository.
#
# Install:  cp git-hooks/pre-commit git-hooks/commit-msg .git/hooks/
# Remove:   rm .git/hooks/pre-commit .git/hooks/commit-msg
#
# Every check runs against the staged content (`git grep --cached`), so what is
# committed is what was tested.

set -euo pipefail

fail() { printf '\033[0;31mBLOCKED\033[0m %s\n' "$1"; exit 1; }
warn() { printf '\033[0;33mWARN\033[0m   %s\n' "$1"; }
ok()   { printf '\033[0;32mOK\033[0m     %s\n' "$1"; }

echo "Running repository gates..."
echo

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && { echo "Nothing staged."; exit 0; }

# Directories that are deliberately excluded from the secret grep:
#   test/fixtures  - the parity corpus must contain pattern-shaped fake keys
#   git-hooks      - the patterns themselves
EXCLUDES=(':!test/fixtures' ':!git-hooks' ':!package-lock.json')

# ---------- 1. Secrets ----------
echo "1/6 secrets"
if git grep --cached -nEI \
    'AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|sk_live_[0-9a-zA-Z]{24}|xox[baprs]-[A-Za-z0-9-]+|npm_[A-Za-z0-9]{36}' \
    -- . "${EXCLUDES[@]}" 2>/dev/null | grep -v 'soloknuckle:allow'; then
  fail "possible credentials in the staged diff (see above). Use 'soloknuckle:allow' only for fixtures."
fi

BLOCKED_FILES=$(echo "$STAGED" | grep -E '(^|/)\.env($|\.)|\.pem$|\.key$|\.p12$|\.pfx$' || true)
if [ -n "$BLOCKED_FILES" ]; then
  fail "refusing to commit key material: $BLOCKED_FILES"
fi
ok "no secrets"

# ---------- 2. Forbidden patterns ----------
echo "2/6 forbidden patterns"
if git grep --cached -nE '\beval\s*\(|new Function\s*\(|dangerouslySetInnerHTML' \
    -- . "${EXCLUDES[@]}" ':!*.md' 2>/dev/null; then
  fail "forbidden pattern above. If it is genuinely required, justify it in the commit message and use --no-verify."
fi
ok "none found"

# ---------- 3. Typecheck ----------
echo "3/6 typecheck"
if [ -f tsconfig.json ] && [ -x node_modules/.bin/tsc ]; then
  npm run typecheck --silent || fail "typecheck failed"
  ok "typecheck"
else
  warn "TypeScript not installed - skipping typecheck"
fi

# ---------- 4. Lint ----------
echo "4/6 lint"
if [ -f package.json ] && grep -q '"lint"[[:space:]]*:' package.json; then
  npm run lint --silent || fail "lint failed"
  ok "lint"
else
  warn "no lint script - skipping"
fi

# ---------- 5. Tests ----------
echo "5/6 tests"
if [ -f package.json ] && grep -q '"test"[[:space:]]*:' package.json; then
  # Run directly: capturing the status of a piped command substitution is a
  # trap (PIPESTATUS does not survive `VAR=$(... | ...)`), and a gate that
  # cannot fail is worse than no gate.
  npm test --silent || fail "tests failed"
  ok "tests"
else
  warn "no test script - skipping"
fi

# ---------- 6. Accessibility (static HTML in this repository) ----------
echo "6/6 accessibility"
A11Y_FILES=$(echo "$STAGED" | grep -E '\.(html|tsx|jsx|vue|svelte)$' || true)
if [ -n "$A11Y_FILES" ]; then
  if echo "$A11Y_FILES" | xargs git grep --cached -nE '<img\s[^>]*>' -- 2>/dev/null \
      | grep -v 'alt=' | grep -v 'alt=""'; then
    fail "<img> without alt text above"
  fi
  if echo "$A11Y_FILES" | xargs git grep --cached -nE '<button(\s[^>]*)?>\s*</button>' -- 2>/dev/null; then
    fail "empty <button> above - it needs a visible label or aria-label"
  fi
  ok "a11y"
else
  ok "a11y (no markup changed)"
fi

# ---------- Branch discipline ----------
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ] || [ "$BRANCH" = "develop" ]; then
  fail "committing directly to '$BRANCH'. Use a feature/* branch and open a PR."
fi

echo
ok "all gates passed ($BRANCH)"
