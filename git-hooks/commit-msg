#!/usr/bin/env bash
# commit-msg - enforces Conventional Commits in this repository.
#
#   <type>(<scope>): <subject>
#
# The subject says why the change exists; the diff already says what changed.
# A body is expected for anything that is not trivially obvious.

set -euo pipefail

MSG_FILE="${1:?commit message file required}"
FIRST_LINE=$(head -n 1 "$MSG_FILE")

# Merge and revert commits are generated by git.
case "$FIRST_LINE" in
  Merge*|Revert*) exit 0 ;;
esac

TYPES='feat|fix|refactor|chore|docs|test|perf|security|style|build|ci'

if ! printf '%s' "$FIRST_LINE" | grep -qE "^(${TYPES})(\([a-z0-9.,-]+\))?: .+"; then
  printf '\033[0;31mBLOCKED\033[0m commit message must follow Conventional Commits:\n'
  echo "  <type>(<scope>): <subject>"
  echo ""
  echo "  types: feat | fix | refactor | chore | docs | test | perf | security | style | build | ci"
  echo "  got:   $FIRST_LINE"
  exit 1
fi

SUBJECT=${FIRST_LINE#*: }
if [ "${#SUBJECT}" -gt 72 ]; then
  printf '\033[0;33mWARN\033[0m subject is %d characters; keep it under 72.\n' "${#SUBJECT}"
fi

case "$SUBJECT" in
  *.) printf '\033[0;33mWARN\033[0m subject ends with a period.\n' ;;
esac

exit 0
